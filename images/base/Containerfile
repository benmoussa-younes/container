#
# The container base image.
#
#   podman build \
#     --build-arg VERSION="$(cat VERSION)" \
#     --build-arg REVISION="$(git rev-parse HEAD)" \
#     --build-arg CREATED="$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
#     -t localhost/benmoussa/container:test images/base
#
# The base is Debian's minimal one, pinned by digest for reproducibility. The
# image carries what a workload needs and nothing else: TLS roots, the zone
# data `Timezone=` reads, `curl` for healthchecks, `procps` for a shell inside a
# running container, and the Scripts interpreter the site's scripts run on. No
# sshd, no sudo, no compiler, no package lists.
#
# Scripts is a separate work under the GPL-3.0-or-later; the release package is
# verified against the release's own SHA256SUMS before it is installed, and the
# version is pinned here.
FROM docker.io/library/debian:13-slim@sha256:7378260c0a098d27ac206225db5e7d92b8c7c84ea7afccc86eeb513756bbd392

# The site passes these at build time; nothing here hardcodes the collection
# version, so a release cannot leave a stale label behind. `CREATED` is the
# site's choice: a fixed value makes the build reproducible, `date -u` does not.
ARG VERSION=""
ARG REVISION=""
ARG CREATED=""

LABEL org.opencontainers.image.title="Container base image" \
      org.opencontainers.image.description="Debian minimal base for the site's containers: TLS roots, tzdata, curl, procps, a non-root account and no setuid" \
      org.opencontainers.image.vendor="Younes BENMOUSSA" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.created="${CREATED}" \
      org.opencontainers.image.source="https://github.com/benmoussa-younes/container" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later" \
      org.opencontainers.image.base.name="docker.io/library/debian:13-slim" \
      org.opencontainers.image.base.digest="sha256:7378260c0a098d27ac206225db5e7d92b8c7c84ea7afccc86eeb513756bbd392"

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# One layer: install and clean in the same step, so the package lists never
# reach a layer of their own. The image keeps Debian's own `/etc/os-release`:
# the collection owns no identity, so it writes none and brands no distribution.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates \
      tzdata \
      curl \
      procps \
 && curl -fsSL -o /tmp/scripts.deb \
      https://github.com/benmoussa-younes/scripts/releases/download/v0.3.0/scripts_0.3.0_amd64.deb \
 && echo "d98fea8b98cc5e6c99b87d6178e91431830786761fcc20334d18e97ae8e64c60  /tmp/scripts.deb" \
      | sha256sum -c - \
 && apt-get install -y --no-install-recommends /tmp/scripts.deb \
 && rm -f /tmp/scripts.deb \
 && rm -rf /var/lib/apt/lists/* \
 && /usr/bin/scripts --version

# A setuid or setgid bit is useless once every capability is dropped, and it is
# a known escalation vector with them. The run-time drop-in drops them all.
# One non-root account, no login shell, a locked root: nothing to log in as.
# `/work` is where a site mounts its content.
RUN useradd --uid 1000 --create-home --shell /usr/sbin/nologin app \
 && passwd -l root \
 && mkdir -p /work \
 && chown app:app /work \
 && find / -xdev -perm /6000 -type f -exec chmod ug-s {} +

USER 1000:1000
WORKDIR /work
