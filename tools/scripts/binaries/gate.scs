#!/usr/bin/scripts run
# gate.scs — one command, one verdict for the Container collection.
#
#   scripts run tools/scripts/binaries/gate.scs
#
# It checks the tree, the version, the licences, the legacy names, the secret
# and site-value shapes, the syntax of every playbook and the collection
# archive itself. It writes nothing outside a temporary directory
# and ends with exactly one VERDICT line.

import "../modules/verdict.scs" as verdict
import "../modules/repo.scs" as repo
import "../modules/secrets.scs" as secrets

let root: path = repo.root_path_from(process.script_path())

function note(ok_value: boolean, name: string, detail: string) -> list<string> {
    if ok_value {
        io.write_standard_output_line("PASS " + name)
        return []
    }
    let line = verdict.defect(name, "FAIL", detail.trim_whitespace())
    io.write_standard_output_line(line)
    return [line]
}

function read_text(root: path, relative: string) -> string {
    match filesystem.read_file(root / relative) {
        ok(content) => {
            return content
        }
        error(_failure) => {
            return ""
        }
    }
}

# The program is a literal at every call site: a computed program cannot be
# checked against the launcher list (SCRIPTS-LINT-0004). The request value keeps
# the program name for the failure message.
# A defect carries the first ten lines that name it, never a whole log: the
# runner's distilled-output rule applies to the gate's own report too.
function first_lines(text: string, limit: integer) -> string {
    let mutable kept: list<string> = []
    for line in text.lines() {
        if kept.length() >= limit {
            break
        }
        if line.trim_whitespace().length() > 0 {
            kept.append(line)
        }
    }
    return kept.join("\n")
}

# A playbook that fails names the reason at the end (`fatal:` and the recap); the
# head of its output is only the play and task headers.
function tail_lines(text: string, limit: integer) -> string {
    let mutable all: list<string> = []
    for line in text.lines() {
        if line.trim_whitespace().length() > 0 {
            all.append(line)
        }
    }
    let mutable start = 0
    if all.length() > limit {
        start = all.length() - limit
    }
    let mutable kept: list<string> = []
    let mutable index = start
    while index < all.length() {
        kept.append(all.get_at_index(index).value_or(""))
        index = index + 1
    }
    return kept.join("\n")
}

function execute_last(root: path, request: run_request, name: string) -> list<string> {
    match process.run(request.with_working_directory(root)) {
        ok(completed) => {
            if completed.exit_code == 0 {
                return note(true, name, "")
            }
            let detail = completed.standard_error + "\n" + completed.standard_output
            return note(false, name, "exit {completed.exit_code}: {tail_lines(detail, 10)}")
        }
        error(failure) => {
            return note(false, name, "cannot run {request.program}: {failure.kind}")
        }
    }
}

function execute(root: path, request: run_request, name: string) -> list<string> {
    match process.run(request.with_working_directory(root)) {
        ok(completed) => {
            if completed.exit_code == 0 {
                return note(true, name, "")
            }
            let detail = completed.standard_error + "\n" + completed.standard_output
            return note(false, name, "exit {completed.exit_code}: {first_lines(detail, 10)}")
        }
        error(failure) => {
            return note(false, name, "cannot run {request.program}: {failure.kind}")
        }
    }
}

function tracked_files(root: path) -> list<string> {
    match process.run(process.request("git", ["ls-files", "--cached"]).with_working_directory(root)) {
        ok(completed) => {
            if completed.exit_code == 0 {
                return completed.standard_output.lines()
            }
            return []
        }
        error(_failure) => {
            return []
        }
    }
}

function any_starts(entries: list<string>, prefix: string) -> boolean {
    for entry in entries {
        if entry.starts_with(prefix) {
            return true
        }
    }
    return false
}

function first_version_after(text: string, marker: string) -> string {
    for line in text.lines() {
        if line.trim_whitespace().starts_with(marker) {
            let captures = line.capture_groups(r"([0-9]+\.[0-9]+\.[0-9]+)").value_or([])
            if captures.length() > 0 {
                return captures.get_at_index(0).value_or("")
            }
        }
    }
    return ""
}

function git_search(root: path, arguments: list<string>, name: string) -> list<string> {
    match process.run(process.request("git", arguments).with_working_directory(root)) {
        ok(completed) => {
            if completed.exit_code == 1 {
                return note(true, name, "")
            }
            if completed.exit_code == 0 {
                return note(false, name, completed.standard_output.trim_whitespace())
            }
            return note(false, name, "git exit {completed.exit_code}: {completed.standard_error.trim_whitespace()}")
        }
        error(failure) => {
            return note(false, name, "cannot run git: {failure.kind}")
        }
    }
}

function git_grep(root: path, flags: list<string>, pattern: string, paths: list<string>) -> list<string> {
    let mutable arguments = ["grep", "-In", "--untracked"]
    for flag in flags {
        arguments.append(flag)
    }
    arguments.append("-e")
    arguments.append(pattern)
    arguments.append("--")
    for entry in paths {
        arguments.append(entry)
    }
    match process.run(process.request("git", arguments).with_working_directory(root)) {
        ok(completed) => {
            if completed.exit_code == 0 {
                return completed.standard_output.lines()
            }
            if completed.exit_code == 1 {
                return []
            }
            # A git error is not an empty result: the sentinel line belongs to no
            # owner, so a failure turns the check red instead of passing.
            return ["! git grep failed ({completed.exit_code}): {completed.standard_error.trim_whitespace()}"]
        }
        error(failure) => {
            return ["! cannot run git: {failure.kind}"]
        }
    }
}

function git_grep_literal(root: path, pattern: string, paths: list<string>) -> list<string> {
    return git_grep(root, ["--fixed-strings"], pattern, paths)
}

function git_grep_regex(root: path, pattern: string, paths: list<string>) -> list<string> {
    return git_grep(root, ["--extended-regexp"], pattern, paths)
}

# `git grep` prints `path:line:text`. A comment cannot write a file, so it is
# not a writer; a line of another file is.
function code_lines(lines: list<string>) -> list<string> {
    let mutable kept: list<string> = []
    for line in lines {
        if not line.contains(":#") {
            kept.append(line)
        }
    }
    return kept
}

function lines_outside_file(lines: list<string>, owner: string) -> list<string> {
    let mutable outside: list<string> = []
    for line in code_lines(lines) {
        if not line.starts_with(owner + ":") {
            outside.append(line)
        }
    }
    return outside
}

function lines_outside_directory(lines: list<string>, directory: string) -> list<string> {
    let mutable outside: list<string> = []
    for line in code_lines(lines) {
        if not line.starts_with(directory) {
            outside.append(line)
        }
    }
    return outside
}

# One owner of `/etc/containers/*.conf.d/99-*-podman.conf`. The product
# writes `99-container-podman.conf` from `roles/podman/`, and the retired
# `99-podman.conf` survives only as a removal target. Untracked files count:
# one is still a second writer on the machine that runs the role.
function check_registries_owner(root: path) -> list<string> {
    let owner = "roles/podman/defaults/main.yml"
    let engine_dir = "roles/podman/"
    # Only a default, a variable, a task, a template or a handler can write a
    # file; prose in a role README or an argument spec describes a name without
    # owning it.
    let code_paths = [
        "roles/*/defaults/**",
        "roles/*/vars/**",
        "roles/*/tasks/**",
        "roles/*/templates/**",
        "roles/*/handlers/**",
        "playbooks/**"
    ]
    let mutable result: list<string> = []
    let legacy = git_grep_literal(root, "99-podman.conf", code_paths)
    for problem in note(lines_outside_file(legacy, owner).length() == 0, "one registries writer", lines_outside_file(legacy, owner).join("; ")) {
        result.append(problem)
    }
    for problem in note(code_lines(legacy).length() > 0, "retired drop-in removed", "no tracked file names `99-podman.conf`, so nothing removes the drop-in the edition roles wrote") {
        result.append(problem)
    }
    # The product promises one `99-*podman*` file, not one spelling of it:
    # any other name of that shape is a second writer.
    let dropins = git_grep_regex(root, "99-[A-Za-z0-9_-]*podman[.]conf", code_paths)
    for problem in note(lines_outside_file(dropins, owner).length() == 0, "one podman drop-in name", lines_outside_file(dropins, owner).join("; ")) {
        result.append(problem)
    }
    let directories = git_grep_literal(root, "registries.conf.d", code_paths)
    for problem in note(lines_outside_file(directories, owner).length() == 0, "registries directory owner", lines_outside_file(directories, owner).join("; ")) {
        result.append(problem)
    }
    # A writer may name one of the engine's variables instead of the path: the
    # directory ones too, because a second file under the same directory is the
    # collision this check exists for.
    for variable in ["podman_registries_dir", "podman_registries_file", "podman_containers_dir", "podman_containers_file"] {
        let lines = git_grep_literal(root, variable, code_paths)
        for problem in note(lines_outside_directory(lines, engine_dir).length() == 0, "engine configuration variable owner", lines_outside_directory(lines, engine_dir).join("; ")) {
            result.append(problem)
        }
    }
    for problem in note(read_text(root, owner).contains("99-container-podman.conf"), "product drop-in name", "{owner} does not name `99-container-podman.conf`") {
        result.append(problem)
    }
    # The removal task has a file of its own, so the state asserted here is the
    # state of that task and not of another `state: absent` in the role.
    let stale = read_text(root, "roles/podman/tasks/stale.yml")
    for problem in note(stale.contains("podman_stale_config_files") and stale.contains("state: absent") and not stale.contains("state: present"), "stale drop-in removed", "roles/podman/tasks/stale.yml does not remove `podman_stale_config_files` with `state: absent`") {
        result.append(problem)
    }
    for problem in note(read_text(root, "roles/podman/tasks/main.yml").contains("include_tasks: stale.yml"), "stale drop-in included", "roles/podman/tasks/main.yml does not include `stale.yml`") {
        result.append(problem)
    }
    return result
}

# The subordinate ID planner decides what `/etc/subuid` and `/etc/subgid` must
# say. It is the one piece of the engine the role must get right before it
# writes: an overlapping range is a corruption vector, and a range the account
# cannot use is an engine that never starts. The cases are fixtures, so a
# change to the planner is proven against the host states it has to survive.
function check_subid_plan(root: path) -> list<string> {
    let planner = "roles/podman/files/subid-plan.awk"
    let cases = [
        "ok|ok|100000|65536|alice|passwd|group|OK 100000 65536",
        "empty|empty|100000|65536|alice|passwd|group|ADD 100000 65536\nPLAN 100000 65536",
        "add after|add-after|100000|65536|alice|passwd|group|ADD 165536 65536\nPLAN 165536 65536",
        "add gap|add-gap|100000|65536|alice|passwd|group|ADD 165536 65536\nPLAN 165536 65536",
        "host uid in block|empty|100000|65536|alice|passwd-high|group-high|ADD 165536 65536\nPLAN 165536 65536",
        "conflict|conflict|100000|65536|alice|passwd|group|CONFLICT 100000 65536 bob\nREMOVE uid 100000 65536\nREMOVE gid 100000 65536\nPLAN 165536 65536",
        "small|small|100000|65536|alice|passwd|group|SMALL 100000 6553\nREMOVE uid 100000 6553\nREMOVE gid 100000 6553\nPLAN 100000 65536",
        "mismatch|mismatch|100000|65536|alice|passwd|group|MISMATCH 100000 200000\nREMOVE uid 100000 65536\nREMOVE gid 200000 65536\nPLAN 100000 65536",
        "half|half|100000|65536|alice|passwd|group|HALF gid\nREMOVE uid 100000 65536\nPLAN 100000 65536",
        "multi|multi|100000|65536|alice|passwd|group|MULTI uid 2\nREMOVE uid 100000 65536\nREMOVE uid 200000 32768\nREMOVE gid 100000 65536\nPLAN 100000 65536",
        "malformed line|badline|100000|65536|bob|passwd|group|BADLINE uid bob:100000",
        "malformed account line|empty|100000|65536|alice|badpasswd|group|BADLINE passwd alice:x:no-uid",
        "own uid in block|empty|100000|65536|alice|passwd-self|group-self|ADD 165536 65536\nPLAN 165536 65536",
        "count at maximum|empty|100000|1048576|alice|passwd|group|ADD 100000 1048576\nPLAN 100000 1048576",
        "count past maximum|empty|100000|1048577|alice|passwd|group|BADARG count",
        "base 0|badarg-base|0|65536|alice|passwd|group|BADARG base",
        "count 0|empty|100000|0|alice|passwd|group|BADARG count",
        "count too big|empty|100000|4000000000|alice|passwd|group|BADARG count"
    ]
    let mutable result: list<string> = []
    for entry in cases {
        let fields = entry.split("|")
        if fields.length() != 8 {
            for problem in note(false, "subid plan case", "`{entry}` does not carry eight fields") {
                result.append(problem)
            }
            continue
        }
        let label = fields.get_at_index(0).value_or("")
        let fixture = fields.get_at_index(1).value_or("")
        let base = fields.get_at_index(2).value_or("")
        let count = fields.get_at_index(3).value_or("")
        let user = fields.get_at_index(4).value_or("")
        let passwd = fields.get_at_index(5).value_or("")
        let group = fields.get_at_index(6).value_or("")
        let want = fields.get_at_index(7).value_or("")
        let uid = "tests/fixtures/subid/{fixture}.subuid"
        let gid = "tests/fixtures/subid/{fixture}.subgid"
        let passwd_file = "tests/fixtures/subid/{passwd}"
        let group_file = "tests/fixtures/subid/{group}"
        let request = process.request("awk", [
            "-f", planner,
            "-v", "user={user}",
            "-v", "base={base}",
            "-v", "count={count}",
            "-v", "uidfile={uid}",
            "-v", "gidfile={gid}",
            "-v", "passwdfile={passwd_file}",
            "-v", "groupfile={group_file}",
            uid,
            gid,
            passwd_file,
            group_file
        ])
        match process.run(request.with_working_directory(root)) {
            ok(completed) => {
                if completed.exit_code != 0 {
                    for problem in note(false, "subid plan {label}", "awk exit {completed.exit_code}: {completed.standard_error.trim_whitespace()}") {
                        result.append(problem)
                    }
                } else {
                    let got = completed.standard_output.trim_whitespace()
                    for problem in note(got == want, "subid plan {label}", "got `{got}` want `{want}`") {
                        result.append(problem)
                    }
                }
            }
            error(failure) => {
                for problem in note(false, "subid plan {label}", "cannot run awk: {failure.kind}") {
                    result.append(problem)
                }
            }
        }
    }
    return result
}

# Writing the range is not using it. The role must remove an unusable range
# before adding one, let the account's pause process adopt the new mapping, and
# read the mapping back from the kernel.
function check_subid_wiring(root: path) -> list<string> {
    let tasks = read_text(root, "roles/podman/tasks/main.yml")
    let apply = read_text(root, "roles/podman/tasks/subuid.yml")
    let plan = read_text(root, "roles/podman/tasks/subuid-plan.yml")
    let defaults = read_text(root, "roles/podman/defaults/main.yml")
    let mutable result: list<string> = []
    for problem in note(tasks.contains("include_tasks: subuid.yml"), "subid included", "roles/podman/tasks/main.yml does not include `subuid.yml`") {
        result.append(problem)
    }
    for problem in note(apply.contains("include_tasks: subuid-plan.yml"), "subid plan applied", "roles/podman/tasks/subuid.yml does not include `subuid-plan.yml`") {
        result.append(problem)
    }
    for problem in note(apply.contains("podman system migrate"), "subid migrate", "roles/podman/tasks/subuid.yml does not run `podman system migrate` after a change") {
        result.append(problem)
    }
    for problem in note(apply.contains("podman unshare cat ") and apply.contains("/proc/self/uid_map") and apply.contains("/proc/self/gid_map"), "subid mapping read back", "roles/podman/tasks/subuid.yml does not read the kernel's uid_map and gid_map back") {
        result.append(problem)
    }
    for problem in note(plan.contains("podman_subuid_repair"), "subid repair declared", "roles/podman/tasks/subuid-plan.yml does not gate the removal of an unusable range on `podman_subuid_repair`") {
        result.append(problem)
    }
    # `/proc/self/uid_map` pads its columns: a comparison without normalisation
    # never matches, which is what the first version of this role did.
    for problem in note(apply.contains("podman_subid_map_lines") and apply.contains("regex_replace"), "subid map normalised", "roles/podman/tasks/subuid.yml compares the kernel's padded map lines without normalising them") {
        result.append(problem)
    }
    for problem in note(defaults.contains("catatonit"), "init package declared", "roles/podman/defaults/main.yml does not install catatonit, which the Quadlet default `RunInit=true` needs") {
        result.append(problem)
    }
    return result
}

function check_paths(root: path) -> list<string> {
    let files = tracked_files(root)
    let mutable result: list<string> = []
    for problem in note(files.length() > 0, "index is not empty", "") {
        result.append(problem)
    }
    let mutable forbidden: list<string> = []
    for file in files {
        if file.starts_with("docs/") or file.starts_with("ci/") or file.starts_with("bench/") or file.starts_with("runs/") {
            forbidden.append(file)
        }
        if file.starts_with(".opencode/") {
            forbidden.append(file)
        }
        if file.starts_with("inventories/") and not file.starts_with("inventories/example/") {
            forbidden.append(file)
        }
        if file.starts_with("scripts/") or file.ends_with(".bcs") {
            forbidden.append(file)
        }
    }
    for problem in note(forbidden.length() == 0, "no forbidden path", forbidden.join(", ")) {
        result.append(problem)
    }
    return result
}

function check_required(root: path) -> list<string> {
    let required = [
        "VERSION",
        "galaxy.yml",
        "meta/runtime.yml",
        "README.md",
        "CHANGELOG.md",
        "LICENSE",
        "NOTICE",
        "REUSE.toml",
        "LICENSES/AGPL-3.0-or-later.txt",
        "playbooks/site.yml",
        "roles/README.md",
        "roles/podman/tasks/main.yml",
        "roles/podman/tasks/subuid.yml",
        "roles/podman/tasks/subuid-plan.yml",
        "roles/podman/files/subid-plan.awk",
        "roles/podman/meta/argument_specs.yml",
        "roles/quadlet/tasks/main.yml",
        "roles/quadlet/meta/argument_specs.yml",
        "inventories/example/hosts.yml",
        "tests/playbooks/subid.yml",
        "tests/playbooks/quadlet.yml",
        "tests/playbooks/verify-sandbox.yml",
        "tests/inventories/sandbox/hosts.yml",
        "tools/scripts/binaries/gate.scs",
        "tools/scripts/binaries/verify-sandbox.scs",
        ".github/workflows/ci.yml",
        ".github/workflows/release.yml"
    ]
    let mutable missing: list<string> = []
    for file in required {
        if not filesystem.path_exists(root / file) {
            missing.append(file)
        }
    }
    return note(missing.length() == 0, "required files", missing.join(", "))
}

function check_version(root: path) -> list<string> {
    let version = read_text(root, "VERSION").trim_whitespace()
    let mutable result: list<string> = []
    for problem in note(version.matches(r"^[0-9]+\.[0-9]+\.[0-9]+$").value_or(false), "VERSION is semver", version) {
        result.append(problem)
    }
    let galaxy = first_version_after(read_text(root, "galaxy.yml"), "version:")
    for problem in note(galaxy == version, "galaxy.yml version", "galaxy={galaxy} VERSION={version}") {
        result.append(problem)
    }
    let changelog = read_text(root, "CHANGELOG.md")
    for problem in note(changelog.contains("## [" + version + "]"), "CHANGELOG entry", "no `## [{version}]` heading") {
        result.append(problem)
    }
    return result
}

# A version is written in four places a reader trusts: `VERSION`,
# `galaxy.yml`, the README badge and a release link, and the supported-version
# table of SECURITY.md. A change that bumps one and not the others ships a lie.
function check_documented_versions(root: path) -> list<string> {
    let version = read_text(root, "VERSION").trim_whitespace()
    let components = version.split(".")
    let minor = "{components.get_at_index(0).value_or("0")}.{components.get_at_index(1).value_or("0")}"
    let readme = read_text(root, "README.md")
    let security = read_text(root, "SECURITY.md")
    let mutable result: list<string> = []
    for problem in note(readme.contains("release-{version}-"), "README badge version", "README.md badge does not name `{version}`") {
        result.append(problem)
    }
    for problem in note(readme.contains("releases/tag/v{version}"), "README release link", "README.md does not link `v{version}`") {
        result.append(problem)
    }
    for problem in note(security.contains("| {minor}.x | yes |"), "SECURITY supported version", "SECURITY.md does not list `{minor}.x` as supported") {
        result.append(problem)
    }
    for problem in note(read_text(root, "AGENTS.md").contains("version `{version}`"), "AGENTS collection version", "AGENTS.md does not name the collection version `{version}`") {
        result.append(problem)
    }
    return result
}

function check_identity(root: path) -> list<string> {
    let galaxy = read_text(root, "galaxy.yml")
    let readme = read_text(root, "README.md")
    let mutable result: list<string> = []
    for problem in note(galaxy.contains("namespace: benmoussa"), "namespace", "galaxy.yml does not declare `namespace: benmoussa`") {
        result.append(problem)
    }
    for problem in note(galaxy.contains("name: container"), "collection name", "galaxy.yml does not declare `name: container`") {
        result.append(problem)
    }
    for problem in note(readme.contains("benmoussa.container"), "README FQCN", "README.md does not name `benmoussa.container`") {
        result.append(problem)
    }
    return result
}

function sha256(root: path, relative: string) -> string {
    match process.run(process.request("sha256sum", [relative]).with_working_directory(root)) {
        ok(completed) => {
            if completed.exit_code == 0 {
                return completed.standard_output.split(" ").get_at_index(0).value_or("")
            }
            return ""
        }
        error(_failure) => {
            return ""
        }
    }
}

function check_licences(root: path, with_gpl: boolean) -> list<string> {
    let agpl_hash = "0d96a4ff68ad6d4b6f1f30f713b18d5184912ba8dd389f86aa7710db079abcb0"
    let cc_hash = "28a9529c7d0bb4dc51f4bf5c116a3d16ef247a052f7591466768ddf563fd1cf5"
    let gpl_hash = "edaef632cbb643e4e7a221717a6c441a4c1a7c918e6e4d56debc3d8739b233f6"
    let mutable result: list<string> = []
    for problem in note(sha256(root, "LICENSE") == agpl_hash, "LICENSE text", "LICENSE is not the AGPL-3.0 text") {
        result.append(problem)
    }
    for problem in note(sha256(root, "LICENSES/AGPL-3.0-or-later.txt") == agpl_hash, "AGPL text", "LICENSES/AGPL-3.0-or-later.txt is not the AGPL-3.0 text") {
        result.append(problem)
    }
    for problem in note(sha256(root, "LICENSES/CC-BY-SA-4.0.txt") == cc_hash, "CC-BY-SA text", "LICENSES/CC-BY-SA-4.0.txt is not the CC-BY-SA-4.0 text") {
        result.append(problem)
    }
    if with_gpl {
        for problem in note(sha256(root, "LICENSES/GPL-2.0-or-later.txt") == gpl_hash, "GPL-2 text", "LICENSES/GPL-2.0-or-later.txt is not the GPL-2.0 text") {
            result.append(problem)
        }
    }
    let galaxy = read_text(root, "galaxy.yml")
    for problem in note(galaxy.contains("AGPL-3.0-or-later"), "galaxy AGPL", "galaxy.yml does not declare AGPL-3.0-or-later") {
        result.append(problem)
    }
    for problem in note(galaxy.contains("CC-BY-SA-4.0"), "galaxy CC-BY-SA", "galaxy.yml does not declare CC-BY-SA-4.0") {
        result.append(problem)
    }
    let notice = read_text(root, "NOTICE")
    for problem in note(notice.contains("AGPL-3.0-or-later"), "NOTICE AGPL", "NOTICE does not name AGPL-3.0-or-later") {
        result.append(problem)
    }
    for problem in note(notice.contains("CC-BY-SA-4.0"), "NOTICE CC-BY-SA", "NOTICE does not name CC-BY-SA-4.0") {
        result.append(problem)
    }
    if with_gpl {
        for problem in note(galaxy.contains("GPL-2.0-or-later"), "galaxy GPL", "galaxy.yml does not declare GPL-2.0-or-later") {
            result.append(problem)
        }
        for problem in note(notice.contains("GPL-2.0-or-later"), "NOTICE GPL", "NOTICE does not name GPL-2.0-or-later") {
            result.append(problem)
        }
    }
    return result
}

function check_archive(root: path) -> list<string> {
    let version = read_text(root, "VERSION").trim_whitespace()
    let mutable result: list<string> = []
    match filesystem.make_temporary_directory("container-gate-") {
        ok(directory) => {
            let build = process.run(process.request("ansible-galaxy", ["collection", "build", "--output-path", directory.to_string()]).with_working_directory(root))
            match build {
                ok(completed) => {
                    if completed.exit_code != 0 {
                        for problem in note(false, "collection build", "exit {completed.exit_code}: {completed.standard_error.trim_whitespace()}") {
                            result.append(problem)
                        }
                    } else {
                        let archive = directory / "benmoussa-container-{version}.tar.gz"
                        if not filesystem.path_exists(archive) {
                            for problem in note(false, "collection archive", archive.to_string()) {
                                result.append(problem)
                            }
                        } else {
                            match process.run(process.request("tar", ["-tzf", archive.to_string()])) {
                                ok(listing) => {
                                    let entries = listing.standard_output.lines()
                                    let required = [
                                        "roles/",
                                        "playbooks/",
                                        "meta/runtime.yml",
                                        "MANIFEST.json",
                                        "FILES.json",
                                        "README.md",
                                        "CHANGELOG.md",
                                        "LICENSE",
                                        "NOTICE",
                                        "REUSE.toml",
                                        "LICENSES/"
                                    ]
                                    let mutable missing: list<string> = []
                                    for entry in required {
                                        if not any_starts(entries, entry) {
                                            missing.append(entry)
                                        }
                                    }
                                    let forbidden = [
                                        "docs/",
                                        "ci/",
                                        "bench/",
                                        "runs/",
                                        ".github/",
                                        "tools/",
                                        ".opencode/",
                                        "inventories/",
                                        "AGENTS.md",
                                        "CONTRIBUTING.md",
                                        "SECURITY.md"
                                    ]
                                    let mutable present: list<string> = []
                                    for entry in forbidden {
                                        if any_starts(entries, entry) {
                                            present.append(entry)
                                        }
                                    }
                                    for problem in note(missing.length() == 0, "archive content", missing.join(", ")) {
                                        result.append(problem)
                                    }
                                    for problem in note(present.length() == 0, "archive exclusion", present.join(", ")) {
                                        result.append(problem)
                                    }
                                }
                                error(failure) => {
                                    for problem in note(false, "archive listing", failure.kind) {
                                        result.append(problem)
                                    }
                                }
                            }
                        }
                    }
                }
                error(failure) => {
                    for problem in note(false, "collection build", "cannot run ansible-galaxy: {failure.kind}") {
                        result.append(problem)
                    }
                }
            }
            match filesystem.remove_directory_tree(directory) {
                ok(_) => {}
                error(failure) => {
                    io.write_standard_error_line("gate: cannot remove {directory.to_string()}: {failure.kind}")
                }
            }
        }
        error(failure) => {
            for problem in note(false, "temporary directory", failure.kind) {
                result.append(problem)
            }
        }
    }
    return result
}

let mutable failures: list<string> = []
for problem in check_paths(root) {
    failures.append(problem)
}
for problem in check_required(root) {
    failures.append(problem)
}
for problem in check_version(root) {
    failures.append(problem)
}
for problem in check_identity(root) {
    failures.append(problem)
}
for problem in check_documented_versions(root) {
    failures.append(problem)
}
for problem in check_registries_owner(root) {
    failures.append(problem)
}
for problem in check_subid_plan(root) {
    failures.append(problem)
}
for problem in check_subid_wiring(root) {
    failures.append(problem)
}
for problem in check_licences(root, false) {
    failures.append(problem)
}
for problem in git_search(root, ["grep", "--cached", "-IniE", "-e", secrets.joined(), "--", ".", ":(exclude)tools", ":(exclude)LICENSES"], "no secret shape") {
    failures.append(problem)
}
for problem in execute(root, process.request("ansible-lint", ["playbooks", "roles", "tests"]), "ansible-lint") {
    failures.append(problem)
}
for problem in execute(root, process.request("yamllint", ["-c", ".yamllint", "roles", "playbooks", "inventories", "tests"]), "yamllint") {
    failures.append(problem)
}
for problem in execute(root, process.request("reuse", ["lint"]), "reuse lint") {
    failures.append(problem)
}
for playbook in ["playbooks/site.yml", "tests/playbooks/subid.yml", "tests/playbooks/verify-sandbox.yml"] {
    for problem in execute(root, process.request("ansible-playbook", ["--syntax-check", playbook]), "syntax " + playbook) {
        failures.append(problem)
    }
}
# The plan is proven, not grepped: the fixtures run the role's own tasks and the
# two answers that must be refused are refused.
for problem in execute_last(root, process.request("ansible-playbook", ["-i", "localhost,", "-c", "local", "tests/playbooks/subid.yml"]), "subid plan proof") {
    failures.append(problem)
}
# The Quadlet decisions are proven the same way: no root, no Podman, only the
# role's own tasks and the files it writes.
for problem in execute_last(root, process.request("ansible-playbook", ["-i", "localhost,", "-c", "local", "tests/playbooks/quadlet.yml"]), "quadlet decision proof") {
    failures.append(problem)
}
for problem in check_archive(root) {
    failures.append(problem)
}

if failures.length() == 0 {
    io.write_standard_output_line(verdict.line(true))
    process.exit_with_code(verdict.code(true))
}
io.write_standard_output_line(verdict.line(false))
process.exit_with_code(verdict.code(false))
