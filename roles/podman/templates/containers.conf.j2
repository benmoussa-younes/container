# Managed by Ansible: the rootless engine uses the account's systemd manager.
#
# Debian's defaults are permissive where a product should decide: no new
# privileges off, logs unbounded, 1024 pids, umask 0022. These values apply to
# every container of the engine, whether a unit declares it or a person runs it.
[engine]
cgroup_manager = "systemd"
events_logger = "journald"
runtime = "{{ podman_runtime }}"

[containers]
no_new_privileges = {{ 'true' if podman_no_new_privileges else 'false' }}
pids_limit = {{ podman_pids_limit }}
log_size_max = {{ podman_log_size_max }}
umask = "{{ podman_umask }}"
