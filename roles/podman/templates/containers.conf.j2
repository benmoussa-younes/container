# Managed by Ansible: the rootless engine uses the account's systemd manager.
#
# Debian's defaults are permissive where a product should decide: a writable
# root file system, unbounded logs, 1024 pids, umask 0022. These values apply to
# every container of the account, whether a unit declares it or a person runs
# it. Podman reads this file before the host-wide ones and the account's values
# win (`man 5 containers.conf`); nothing here applies to root or to another
# user. `no_new_privileges` is not set here: Podman 5.4.2 accepts the key and
# never applies it (measured: NoNewPrivs stays 0 with the key in either table
# and turns 1 with `--security-opt no-new-privileges`), so the product's units
# carry `NoNewPrivileges=true` in the Quadlet hardening drop-in instead.
[engine]
cgroup_manager = "systemd"
events_logger = "journald"
runtime = "{{ podman_runtime }}"
pull_policy = "{{ podman_pull_policy }}"

[containers]
pids_limit = {{ podman_pids_limit }}
log_size_max = {{ podman_log_size_max }}
umask = "{{ podman_umask }}"
read_only = {{ 'true' if podman_read_only else 'false' }}
seccomp_profile = "{{ podman_seccomp_profile }}"
userns = "{{ podman_userns }}"
default_ulimits = {{ podman_default_ulimits | to_json }}

[network]
default_rootless_network_cmd = "pasta"
